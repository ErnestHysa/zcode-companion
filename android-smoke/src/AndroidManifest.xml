<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zcode.android.smoke"
    android:versionCode="1"
    android:versionName="1.0-phase1-smoke">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:label="ZCode Phase1 Smoke" android:exported="true"
        android:usesCleartextTraffic="true">
        <!-- Smoke-only: ws:// to the host mock relay (10.0.2.2). The production relay is
             wss:// so this exception never applies to the real transport. -->
        <activity android:name=".SmokeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
