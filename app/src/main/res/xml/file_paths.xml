<?xml version="1.0" encoding="utf-8"?>
<!-- §23 (file/attachment architecture): app-cache files shared OUT of the app go
     through FileProvider — never raw file:// URIs (API 24+ FileUriExposed). -->
<paths>
    <cache-path name="shared" path="shared/" />
    <!-- AAP-3 (§14.2 T4): downloaded update APKs are handed to the system installer
         through the provider (INV-16: app-private until the consented handoff). -->
    <cache-path name="updates" path="updates/" />
    <!-- F-P33-A (pass-0 Phase 7) stage-2: the artifact-open handoff and the
         attachment-chip external open both write their downloads under these
         cache roots (AppContainer's filesPort cacheDir = downloads/,
         attachmentCacheDir = attachments/) — without the declared roots
         getUriForFile threw IAE and the open arm degraded to a log line. -->
    <cache-path name="downloads" path="downloads/" />
    <cache-path name="attachments" path="attachments/" />
</paths>
