<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app theme. windowBackground is the designed bg (N4.1: the window was
         blank white between splash and first frame — never again). -->
    <style name="Theme.ZCode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!-- B3-splash: the launcher activity uses the core-splashscreen launch theme;
         MainActivity calls installSplashScreen() and hands off to Theme.ZCode. -->
    <style name="Theme.ZCode.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ZCode</item>
    </style>
</resources>
