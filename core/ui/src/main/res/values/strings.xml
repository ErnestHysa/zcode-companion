<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared UI strings (§31: all strings externalized; en = source of truth).
    NOTE (Phase 11, §41.6 clarification): §31 names core:common as the string home,
    but core:common is a PURE-JVM module (domain depends on it, §40.2) and cannot
    carry Android resources — shared strings live in core:ui instead; feature-local
    strings live in their own modules.
-->
<resources>
    <!-- Task status labels (§18.5; colorblind-safe: always rendered next to the
         status glyph/rail — never color alone, §30.6). -->
    <string name="status_idle">Idle</string>
    <string name="status_running">Running</string>
    <string name="status_waiting">Needs attention</string>
    <string name="status_paused">Paused</string>
    <string name="status_completed">Completed</string>
    <string name="status_failed">Failed</string>
    <string name="status_unknown">Unknown</string>

    <!-- Connection phase labels (ConnectionStatusLine). -->
    <string name="conn_connected">Connected</string>
    <string name="conn_syncing">Syncing…</string>
    <string name="conn_reconnecting">Reconnecting…</string>
    <string name="conn_connecting">Connecting…</string>
    <string name="conn_disconnected">Disconnected</string>
    <string name="conn_failed">Connection failed</string>
    <string name="conn_not_connected">Not connected</string>

    <!-- Common actions / a11y labels. -->
    <string name="action_retry">Retry</string>
    <string name="action_refresh">Refresh</string>
    <string name="state_loading">Loading</string>
    <string name="action_back">Back</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_approve">Approve</string>
    <string name="action_deny">Deny</string>
