<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="pairing_title">ZCode Companion</string>
    <string name="welcome_heading">在手机上控制 ZCode</string>
    <string name="welcome_explainer">本应用与您电脑上的 ZCode 桌面端配对。配对后，应用将拥有与桌面端手机远程相同的控制能力：查看任务和对话、实时查看智能体输出、批准或拒绝权限请求。\n\n离开您手机的数据：只有与已配对桌面端通信所需的流量，经由 ZCode 中继（或您稍后配置的服务器）。除此之外没有任何数据 — 无分析、无追踪。\n\n请妥善保管配对链接：任何持有该链接的人都可以操作您的桌面窗口。</string>
    <string name="welcome_resumed_with">已与 %1$s 配对</string>
    <string name="action_scan_qr">扫描二维码</string>
    <string name="action_enter_link">粘贴配对链接</string>
    <string name="action_connect">连接</string>
    <string name="action_unpair">取消此设备的配对</string>
    <string name="camera_needed_title">需要相机权限</string>
    <string name="camera_needed_rationale">扫描 ZCode 桌面端显示的二维码需要使用相机。您也可以改为粘贴配对链接 — 桌面端的远程控制对话框提供“复制链接”。</string>
    <string name="action_grant_camera">重试</string>
    <string name="action_use_manual">改为输入链接</string>
    <string name="scan_title">扫描配对二维码</string>
    <string name="scan_hint">打开 ZCode 桌面端 → 远程控制 → 将相机对准二维码。</string>
    <string name="manual_title">粘贴配对链接</string>
    <string name="manual_hint">桌面端 → 远程控制 → 复制链接，然后粘贴到这里。</string>
    <string name="manual_field_label">配对链接</string>
    <string name="action_validate">继续</string>
    <string name="validating_title">正在验证配对链接…</string>
    <string name="rejected_title">这不是有效的 ZCode 配对链接</string>
    <string name="rejected_format">未保存任何内容。请确认已从桌面端远程控制对话框复制了完整链接，然后重试。</string>
    <string name="stale_title">此二维码可能已过期</string>
    <string name="stale_detail">该链接生成于 10 多分钟前。通常仍然有效 — 但如果配对失败，请在桌面端刷新二维码后重新扫描。</string>
    <string name="action_continue_anyway">仍然继续</string>
    <string name="action_rescan">重新扫描</string>
    <string name="compat_blocked_title">桌面端版本不受支持</string>
    <string name="compat_blocked_detail">桌面端报告的版本为 %1$s。本应用支持 ZCode 桌面端 %2$s 或更新版本。请更新桌面端并重新生成二维码。</string>
    <string name="compat_above_title">未经测试的桌面端版本</string>
    <string name="compat_above_detail">桌面端报告的版本为 %1$s，比本应用测试过的最新版本（%2$s）更新。配对应该可以正常工作；应用会在连接期间检查协议版本。</string>
    <string name="setup_title">安全设置</string>
    <string name="setup_body">您的配对凭据将使用此设备上基于硬件的加密进行封装。除应答中继的身份验证质询外，它绝不会离开设备。</string>
    <string name="setup_biometric_offer">此设备支持生物识别解锁。您可以在查看或移除配对凭据时要求进行验证。</string>
    <string name="setup_biometric_enable">要求生物识别解锁</string>
    <string name="setup_no_lock_title">未检测到屏幕锁定</string>
    <string name="setup_no_lock_detail">此设备没有安全屏幕锁定，因此已封装的凭据的安全性仅取决于设备本身。您可以继续使用较低安全性，或先在 Android 设置中设置屏幕锁定后再配对。</string>
    <string name="action_accept_reduced">以较低安全性继续</string>
    <string name="action_cancel">取消</string>
    <string name="connecting_title">正在连接桌面端…</string>
    <string name="connecting_detail">正在使用配对凭据进行身份验证。这通常只需几秒钟。</string>
    <string name="connect_failed_retry_title">无法连接桌面端</string>
    <string name="connect_failed_repair_title">配对失败 — 链接被拒绝</string>
    <string name="connect_failed_repair_detail">中继拒绝了此配对链接。它可能已在桌面端被刷新或撤销。请生成新的二维码并重新扫描。</string>
    <string name="action_retry">重试</string>
    <string name="takenover_title">已在别处连接</string>
    <string name="takenover_detail">另一个 ZCode 远程页面或设备接管了连接 — 桌面端一次只允许一个连接。您可以重新连接以取回连接。</string>
    <string name="action_takeover_back">重新连接（重新接管）</string>
    <string name="action_dismiss">忽略</string>
    <string name="connected_title">已配对</string>
    <string name="connected_detail">已连接到 %1$s。任务和对话界面将在后续版本中提供 — 配对、安全和恢复功能已生效。</string>
    <string name="unpair_title">取消此设备的配对？</string>
    <string name="unpair_detail">这将删除此手机上的配对凭据和所有密钥材料。另请在桌面端的远程控制对话框中按“停止” — 关闭对话框并不会停止远程控制。</string>
    <string name="action_unpair_confirm">取消配对并清除</string>
    <string name="security_explainer_a11y">安全说明</string>
</resources>
